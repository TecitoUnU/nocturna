# ============================================================================
# NOCTURNA · variables de entorno
#
# Copia este archivo a `.env.local` (desarrollo) y configura las mismas
# variables en el panel de Vercel (producción).
#
# NOCTURNA no utiliza ninguna clave privilegiada (service_role). Todas las
# operaciones pasan por la clave pública y por las políticas RLS de Postgres.
# ============================================================================

# --- Supabase (plan gratuito) ------------------------------------------------
# Project Settings → API → Project URL y "anon public" key
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Identidad de la plataforma (opcional) -----------------------------------
# Cambiar el nombre de la plataforma no obliga a tocar el código.
NEXT_PUBLIC_SITE_NAME=NOCTURNA
NEXT_PUBLIC_SITE_TAGLINE=Archivo audiovisual independiente
NEXT_PUBLIC_SITE_DESCRIPTION=Catálogo audiovisual personal: piezas, ensayos y materiales de archivo publicados y seleccionados a mano.

# URL pública del sitio (para metadatos y sitemap). En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dominios permitidos para miniaturas personalizadas (opcional) ----------
# Lista separada por comas. Por defecto se admiten los dominios de imagen de
# YouTube y el del propio proyecto Supabase.
ALLOWED_THUMBNAIL_HOSTS=
